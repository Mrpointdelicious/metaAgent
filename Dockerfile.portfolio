# Compatibility build entry point. Refresh locked dependencies along with application code.
ARG RUNTIME_IMAGE=meta_agent:docker-cutover-20261021-budget
FROM python:3.12-slim AS dependencies
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.16
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --extra postgres --extra llm-deepseek --no-editable

FROM ${RUNTIME_IMAGE}
COPY --from=dependencies --chown=metaagent:metaagent /opt/venv /opt/venv
