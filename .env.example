META_AGENT__APP_ENV=development
META_AGENT__LOG_LEVEL=INFO
# 日志落盘目录（为空则仅 stdout）。设置后在该目录写滚动 JSON 文件 meta_agent.log。
META_AGENT__LOG_DIR=
# META_AGENT__LOG_FILE_NAME=meta_agent.log
# META_AGENT__LOG_MAX_BYTES=10485760
# META_AGENT__LOG_BACKUP_COUNT=5
META_AGENT__SERVICE_BEARER_TOKEN=replace-service-token
META_AGENT__AI_WEBAPI_BASE_URL=http://host.docker.internal:5043/api/ai/patients/tools
META_AGENT__AI_WEBAPI_REHAB_BASE_URL=http://host.docker.internal:5043/api/ai/rehab/tools
# 医院运营接口可单独指向另一套后端；单独指向时配置其独立 token，否则沿用上面 token。
META_AGENT__AI_WEBAPI_HOSPITAL_BASE_URL=
META_AGENT__AI_WEBAPI_HOSPITAL_BEARER_TOKEN=
META_AGENT__AI_WEBAPI_BEARER_TOKEN=replace-webapi-token
META_AGENT__DRY_RUN=true
META_AGENT__PERSISTENCE_BACKEND=memory
META_AGENT_POSTGRES_PASSWORD=replace-database-password
META_AGENT__POSTGRES_DSN=postgresql://meta_agent:replace-database-password@postgres:5432/meta_agent
META_AGENT__AUTO_SETUP_PERSISTENCE=false
META_AGENT__DEFAULT_TENANT_ID=default
META_AGENT__ORCHESTRATION_MODE=agent
META_AGENT__AGENT_MODEL=deepseek:deepseek-chat
META_AGENT__AGENT_MAX_MODEL_CALLS=8
META_AGENT__AGENT_MODEL_TIMEOUT_SECONDS=30
META_AGENT__AGENT_TOOL_OUTPUT_TOKENS=3000
META_AGENT__AGENT_HISTORY_TOKENS=8000
# 自定义 Agent 系统提示词（可选）：为空时用内置 SYSTEM_PROMPT；设置后整体替换，
# 改提示词只需改这里并重启容器，无需重建镜像。
# META_AGENT__AGENT_SYSTEM_PROMPT=
META_AGENT__PLANNER_MODE=deterministic
META_AGENT__PLANNER_MODEL=deepseek:deepseek-chat
META_AGENT__PLANNER_MAX_RETRIES=0
META_AGENT__PLANNER_INPUT_TOKENS=6000
META_AGENT__MULTISOURCE_PATIENT_CONTEXT_ENABLED=false
META_AGENT__IRETOUR_REPORTS_ENABLED=false
META_AGENT__DEEPSEEK_API_KEY=
META_AGENT__ANSWER_MODE=template
META_AGENT__SCENE_ACTIONS_ENABLED=false
META_AGENT__KNOWLEDGE_CORPUS_PATH=
META_AGENT__ARTIFACT_ALLOWED_HOSTS=[]
META_AGENT__WORKER_COUNT=1
META_AGENT__REQUEST_TIMEOUT_SECONDS=60
META_AGENT__MAX_PARALLEL_TASKS=4
META_AGENT__MAX_CONCURRENT_REQUESTS=20
META_AGENT__MAX_CONCURRENT_TOOLS=8
META_AGENT__EVIDENCE_TTL_SECONDS=1800
META_AGENT__RUN_TTL_SECONDS=1800
META_AGENT__CONVERSATION_TTL_SECONDS=86400
META_AGENT__CLEANUP_INTERVAL_SECONDS=3600

# IReCog and online assessment read tools use the trusted project patient identity.
# Report generation is opt-in; read/history/analysis tools do not require these flags.
META_AGENT__IRECOG_REPORTS_ENABLED=false
META_AGENT__ASSESSMENT_REPORTS_ENABLED=false

# External services implementing knowledge-search-v1. Restart after changing configuration.
# One JSON line; endpoints, credentials, hospital bindings and retrieval stay server-owned.
META_AGENT__KNOWLEDGE_SOURCES=[]
META_AGENT__KNOWLEDGE_CONTEXT_TOKENS=4000
# Example: [{"id":"medical","description":"医学文献","url":"http://rag-portfolio-api:8000/v1/knowledge/search","domains":["health"],"token_env":"MEDICAL_KNOWLEDGE_TOKEN"},{"id":"hospital","description":"医院说明","url":"http://rag-portfolio-api:8000/v1/knowledge/search","domains":["help","product"],"scoped_domains":["help","product"],"token_env":"HOSPITAL_KNOWLEDGE_TOKEN"}]
# token_env supports both this .env file and process environment (process wins).
MEDICAL_KNOWLEDGE_TOKEN=
HOSPITAL_KNOWLEDGE_TOKEN=

# Patient tools use only contract 2.0.0 under the same AI_WEBAPI_BASE_URL.
# The authenticated gateway supplies patient_identity, identity_context_token,
# current_business_id and data_scope in request inputs. Do not store the business
# signing key in MetaAgent or put credentials in model-visible tool arguments.
# Default data_scope is all_tenants. current_tenant requires current_business_id.
# Local integration configuration is opt-in and contains secrets; keep it in .local/.
# META_AGENT_LIVE_PATIENT_V2_CONFIG=D:/private/live-patient-v2.json

# Optional Dify workflow/node lifecycle events; settled message/message_end remain compatible.
META_AGENT__DIFY_WORKFLOW_EVENTS_ENABLED=false
# Secondary service client: credential only identifies the gateway, never a patient.
META_AGENT__SERVICE_BEARER_TOKEN_SECONDARY=
META_AGENT__SECONDARY_EXCLUDED_TOOLS=[]
# History HTTP APIs additionally require app.state.business_identity_provider.
# Supply a deployment adapter that verifies actual business-login sessions; never trust headers alone.
