META_AGENT__APP_ENV=development
META_AGENT__LOG_LEVEL=INFO
META_AGENT__SERVICE_BEARER_TOKEN=<random-service-token>
META_AGENT__AI_WEBAPI_BASE_URL=http://host.docker.internal:5043/api/ai/patients/tools
META_AGENT__AI_WEBAPI_REHAB_BASE_URL=http://host.docker.internal:5043/api/ai/rehab/tools
META_AGENT__AI_WEBAPI_BEARER_TOKEN=<ai-webapi-service-token>
META_AGENT__DRY_RUN=true
META_AGENT__PERSISTENCE_BACKEND=memory
META_AGENT_POSTGRES_PASSWORD=<postgres-password>
META_AGENT__POSTGRES_DSN=postgresql://meta_agent:<password>@postgres:5432/meta_agent
META_AGENT__AUTO_SETUP_PERSISTENCE=false
META_AGENT__DEFAULT_TENANT_ID=default

# Legacy MaxKB lab settings. Disabled in the current runtime, including when set true.
META_AGENT__MAXKB_ENABLED=false
META_AGENT__MAXKB_URL=http://host.docker.internal:18081/admin/api
META_AGENT__MAXKB_CONFIG_PATH=
META_AGENT__MAXKB_PUBLIC_BASE_URL=http://127.0.0.1:18084
META_AGENT__MAXKB_RELEASE_PATH=
META_AGENT__MAXKB_TOP_K=3
META_AGENT__MAXKB_TIMEOUT_SECONDS=20
META_AGENT__MAXKB_ANSWER_MODE=llm
META_AGENT__MAXKB_ANSWER_TIMEOUT_SECONDS=30

META_AGENT__ORCHESTRATION_MODE=agent
META_AGENT__PROMPT_BUNDLE=builtin-v1
META_AGENT__AGENT_MODEL=deepseek:deepseek-chat
# Per-model-call output limit, 128-8192; omit to inherit PLANNER_MAX_TOKENS.
META_AGENT__AGENT_MAX_OUTPUT_TOKENS=4096
META_AGENT__AGENT_MAX_MODEL_CALLS=8
META_AGENT__AGENT_MODEL_TIMEOUT_SECONDS=30
META_AGENT__AGENT_TOOL_OUTPUT_TOKENS=16000
META_AGENT__AGENT_HISTORY_TOKENS=24000
META_AGENT__MODEL_CONTEXT_TOKENS=65536
META_AGENT__PLANNER_MODE=deterministic
META_AGENT__PLANNER_MODEL=deepseek:deepseek-chat
META_AGENT__PLANNER_MAX_TOKENS=2048
META_AGENT__PLANNER_MAX_RETRIES=0
META_AGENT__PLANNER_INPUT_TOKENS=6000
META_AGENT__MULTISOURCE_PATIENT_CONTEXT_ENABLED=false
META_AGENT__IRETOUR_REPORTS_ENABLED=false
META_AGENT__AI_WEBAPI_HOSPITAL_BASE_URL=
META_AGENT__DEEPSEEK_API_KEY=
META_AGENT__ANSWER_MODE=template
META_AGENT__SCENE_ACTIONS_ENABLED=false
META_AGENT__KNOWLEDGE_CORPUS_PATH=
# Preferred: any number of independent services implementing knowledge-search-v1.
# First source supporting a domain is its default; the model can select another logical source.
META_AGENT__KNOWLEDGE_SOURCES=[]
META_AGENT__KNOWLEDGE_CONTEXT_TOKENS=4000
# Example (one JSON line): [{"id":"medical","description":"医学文献","url":"http://rag-portfolio-api:8000/v1/knowledge/search","domains":["health"],"token_env":"MEDICAL_KNOWLEDGE_TOKEN"},{"id":"hospital","description":"医院说明与产品资料","url":"http://rag-portfolio-api:8000/v1/knowledge/search","domains":["help","product"],"scoped_domains":["help","product"],"token_env":"HOSPITAL_KNOWLEDGE_TOKEN"}]
# Credentials are supplied to the process, separately from model-visible source metadata.
MEDICAL_KNOWLEDGE_TOKEN=
HOSPITAL_KNOWLEDGE_TOKEN=
META_AGENT__ARTIFACT_ALLOWED_HOSTS=[]
# Match the backend ReportImage/PublicBaseUrl settings. Browser URL stays public;
# known report paths are checked over AI_WEBAPI_*_BASE_URL inside Docker.
META_AGENT__ARTIFACT_PUBLIC_BASE_URL=
META_AGENT__WORKER_COUNT=1
META_AGENT__REQUEST_TIMEOUT_SECONDS=60
META_AGENT__MAX_PARALLEL_TASKS=4
META_AGENT__MAX_CONCURRENT_REQUESTS=20
META_AGENT__MAX_CONCURRENT_TOOLS=8
META_AGENT__EVIDENCE_TTL_SECONDS=1800
META_AGENT__RUN_TTL_SECONDS=1800
META_AGENT__CONVERSATION_TTL_SECONDS=86400
META_AGENT__CLEANUP_INTERVAL_SECONDS=3600
# Legacy /v1/retrieve compatibility; ignored for retrieval when KNOWLEDGE_SOURCES is configured.
META_AGENT__PORTFOLIO_ENABLED=false
META_AGENT__PORTFOLIO_BASE_URL=http://rag-portfolio-api:8000
META_AGENT__PORTFOLIO_TOKEN=
# Global medical literature KBs, independent of spaceId.
META_AGENT__PORTFOLIO_KB_IDS=[]
# Hospital help/product only; medical health ignores this mapping.
# Example: {"上海中医药大学附属岳阳医院":{"help":["<hospital-kb-uuid>"],"product":["<hospital-kb-uuid>"]}}
META_AGENT__PORTFOLIO_SPACE_KB_IDS={}
# Optional reader credential for the patient-facing hospital/help corpus.
META_AGENT__PORTFOLIO_HELP_TOKEN=
META_AGENT__PORTFOLIO_TIMEOUT_SECONDS=20
META_AGENT__PORTFOLIO_TOP_K=5
META_AGENT__PORTFOLIO_CONTEXT_TOKENS=4000
# Enable after publishing a reviewed RAG scene catalog; no bundled fallback in remote mode.
META_AGENT__PORTFOLIO_SCENE_CATALOG_ENABLED=false
META_AGENT__PORTFOLIO_SCENE_CATALOG_TTL_SECONDS=30
