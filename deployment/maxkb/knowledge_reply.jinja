{# Native Reply node: format retrieved paragraphs, without an answering model. #}
{% set state = namespace(context='', sources=[], truncated=false) %}
{% set budget = [global.max_context_tokens|int, 16000]|min %}
{% for item in Evidence.result_list %}
  {% set p = item.get('metadata', item) %}
  {% set text = p.get('content', '') %}
  {% if text and state.sources|length < 4 %}
    {% set sid = 'S' ~ (state.sources|length + 1) %}
    {% set title = p.get('document_name', '') or p.get('title', '') or 'MaxKB document' %}
    {% set locator = p.get('title', '') or ('paragraph ' ~ p.get('id', '')) %}
    {% set ref = 'maxkb://' ~ p.get('knowledge_id', '') ~ '/' ~ p.get('document_id', '') ~ '/' ~ p.get('id', '') ~ '@' ~ p.get('update_time', '') %}
    {% set source = {'id':sid, 'title':title, 'locator':locator, 'ref':ref} %}
    {% set header = '\n[' ~ sid ~ '] ' ~ title ~ ' · ' ~ locator ~ '\n' %}
    {% set cost = (state.context ~ header).encode('utf-8')|length + ((state.sources + [source])|tojson)|length %}
    {% set remaining = budget - cost %}
    {% if remaining > 0 %}
      {% if text.encode('utf-8')|length > remaining %}
        {% set text = text[:remaining // 4] %}
        {% set state.truncated = true %}
      {% endif %}
      {% if text|trim %}
        {% set state.context = state.context ~ header ~ text %}
        {% set state.sources = state.sources + [source] %}
      {% endif %}
    {% else %}
      {% set state.truncated = true %}
    {% endif %}
  {% endif %}
{% endfor %}
{% set status = 'no_evidence' if not state.sources else ('partial' if state.truncated else 'ok') %}
{% set gaps = ['上下文预算不足，请缩小问题范围。'] if state.truncated else ([] if state.sources else ['当前范围未找到足够的已发布证据。']) %}
{{ {'status':status, 'context':state.context, 'sources':state.sources, 'gaps':gaps, 'trace_id':global.chat_id}|tojson }}
