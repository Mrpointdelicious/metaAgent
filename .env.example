META_AGENT__APP_ENV=development
META_AGENT__LOG_LEVEL=INFO
# 日志落盘目录（为空则仅 stdout）。设置后在该目录写滚动 JSON 文件 meta_agent.log。
META_AGENT__LOG_DIR=
# META_AGENT__LOG_FILE_NAME=meta_agent.log
# META_AGENT__LOG_MAX_BYTES=10485760
# META_AGENT__LOG_BACKUP_COUNT=5
META_AGENT__SERVICE_BEARER_TOKEN=<random-service-token>
META_AGENT__AI_WEBAPI_BASE_URL=http://host.docker.internal:5043/api/ai/patients/tools
META_AGENT__AI_WEBAPI_REHAB_BASE_URL=http://host.docker.internal:5043/api/ai/rehab/tools
# 医院运营接口可单独指向另一套后端；单独指向时配置其独立 token，否则沿用上面 token。
META_AGENT__AI_WEBAPI_HOSPITAL_BASE_URL=
META_AGENT__AI_WEBAPI_HOSPITAL_BEARER_TOKEN=
META_AGENT__AI_WEBAPI_BEARER_TOKEN=<ai-webapi-service-token>
META_AGENT__DRY_RUN=true
META_AGENT__PERSISTENCE_BACKEND=memory
META_AGENT_POSTGRES_PASSWORD=<postgres-password>
META_AGENT__POSTGRES_DSN=postgresql://meta_agent:<password>@postgres:5432/meta_agent
META_AGENT__AUTO_SETUP_PERSISTENCE=false
META_AGENT__DEFAULT_TENANT_ID=default
META_AGENT__ORCHESTRATION_MODE=agent
META_AGENT__AGENT_MODEL=deepseek:deepseek-chat
META_AGENT__AGENT_MAX_MODEL_CALLS=8
META_AGENT__AGENT_MODEL_TIMEOUT_SECONDS=30
META_AGENT__AGENT_TOOL_OUTPUT_TOKENS=3000
META_AGENT__AGENT_HISTORY_TOKENS=8000
# 自定义 Agent 系统提示词（可选）：为空时用内置 SYSTEM_PROMPT；设置后整体替换，
# 改提示词只需改这里并重启容器，无需重建镜像。
# META_AGENT__AGENT_SYSTEM_PROMPT=
META_AGENT__PLANNER_MODE=deterministic
META_AGENT__PLANNER_MODEL=deepseek:deepseek-chat
META_AGENT__PLANNER_MAX_RETRIES=0
META_AGENT__PLANNER_INPUT_TOKENS=6000
META_AGENT__MULTISOURCE_PATIENT_CONTEXT_ENABLED=false
META_AGENT__IRETOUR_REPORTS_ENABLED=false
META_AGENT__DEEPSEEK_API_KEY=
META_AGENT__ANSWER_MODE=template
META_AGENT__SCENE_ACTIONS_ENABLED=false
META_AGENT__KNOWLEDGE_CORPUS_PATH=
# 知识库接入方式：original = 原先知识库（直连 richtxt，search_company_knowledge 工具），
# maxkb = MaxKB 原生 API 直连（search_knowledge 工具）。设 maxkb 时需在 META_AGENT__KNOWLEDGE_SOURCES
# 中配置 protocol=maxkb 的知识源。
META_AGENT__KNOWLEDGE_BACKEND=original
META_AGENT__ARTIFACT_ALLOWED_HOSTS=[]
META_AGENT__WORKER_COUNT=1
META_AGENT__REQUEST_TIMEOUT_SECONDS=60
META_AGENT__MAX_PARALLEL_TASKS=4
META_AGENT__MAX_CONCURRENT_REQUESTS=20
META_AGENT__MAX_CONCURRENT_TOOLS=8
META_AGENT__EVIDENCE_TTL_SECONDS=1800
META_AGENT__RUN_TTL_SECONDS=1800
META_AGENT__CONVERSATION_TTL_SECONDS=604800
META_AGENT__CLEANUP_INTERVAL_SECONDS=3600

# webyun 直连业务接口的固定服务账号（场景指令 / 医生 / 问诊房间共用）
META_AGENT__WEBYUN_LOGIN_PHONE=
META_AGENT__WEBYUN_LOGIN_PASSWORD=
# 场景指令 .NET 直连接口（192.168.8.160/back/*）的 apikey / apitoken
META_AGENT__SCENE_BACKEND_API_KEY=
META_AGENT__SCENE_BACKEND_API_TOKEN=
# 处方疾病提取专用 DeepSeek key（照搬 Dify 代码节点，独立于主 DEEPSEEK_API_KEY）
META_AGENT__PRESCRIPTION_DEEPSEEK_API_KEY=
